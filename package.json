{
  "name": "portfolio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:store": "turbo run dev -F web --",
    "db:push:store": "turbo run db:push -F web --",
    "db:studio:store": "turbo run db:studio -F web --",
    "db:generate:store": "turbo run db:generate -F web --",
    "db:migrate:store": "turbo run db:migrate -F web --",
    "dev:real-state": "turbo run dev -F real-state --",
    "db:push:real-state": "turbo run db:push -F real-state --",
    "db:studio:real-state": "turbo run db:studio -F real-state --",
    "db:generate:real-state": "turbo run db:generate -F real-state --",
    "db:migrate:real-state": "turbo run db:migrate -F real-state --",
    "dev:services": "turbo run dev -F services --",
    "db:push:services": "turbo run db:push -F services --",
    "db:studio:services": "turbo run db:studio -F services --",
    "db:generate:services": "turbo run db:generate -F services --",
    "db:migrate:services": "turbo run db:migrate -F services --",
    "env:generate": "varlock codegen --path ./apps/store/ && varlock codegen --path ./apps/real-state/ && varlock codegen --path ./apps/services/",
    "postinstall": "varlock codegen --path ./apps/store/ && varlock codegen --path ./apps/real-state/ && varlock codegen --path ./apps/services/",
    "auth:generate": "cd apps/store && pnpm run auth:generate",
    "dev:prices": "turbo run dev -F prices --"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@portfolio/config": "workspace:*",
    "@types/node": "catalog:",
    "turbo": "^2.11.7",
    "typescript": "catalog:",
    "varlock": "catalog:"
  },
  "packageManager": "pnpm@11.5.1"
}
